<Window x:Class="Калькулятор.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Калькулятор"
        mc:Ignorable="d"
        Title="Калькулятор" Height="480" Width="360" MinHeight="400" MinWidth="300" WindowStartupLocation="CenterScreen">

    <!-- Главная сетка, которая делит окно на область экрана и область кнопок -->
    <Grid Background="#F3F3F3">
        <!-- Определение двух строк: верхняя авто-строка для дисплея, нижняя — под кнопки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Строка для экрана -->
            <RowDefinition Height="*"/>
            <!-- Строка для кнопок, забирает все свободное место -->
        </Grid.RowDefinitions>

        <!-- Дисплей калькулятора, куда выводятся вводимые цифры и результаты вычислений -->
        <TextBlock x:Name="Display" 
                   Grid.Row="0" 
                   Text="0" 
                   FontSize="40" 
                   TextAlignment="Right" 
                   VerticalAlignment="Center"
                   Padding="15" 
                   Background="White" 
                   Margin="10"/>

        <!-- Вложенная сетка (Grid) для создания ровной таблицы кнопок калькулятора -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
            <!-- Определение 5 строк одинакового размера для сетки кнопок -->
            <Grid.RowDefinitions>
                <RowDefinition/>
                <!-- 1-я строка (C, Backspace, Деление) -->
                <RowDefinition/>
                <!-- 2-я строка (7, 8, 9, Умножение) -->
                <RowDefinition/>
                <!-- 3-я строка (4, 5, 6, Вычитание) -->
                <RowDefinition/>
                <!-- 4-я строка (1, 2, 3, Сложение) -->
                <RowDefinition/>
                <!-- 5-я строка (+/-, 0, Запятая, Равно) -->
            </Grid.RowDefinitions>
            <!-- Определение 4 столбцов одинакового размера для сетки кнопок -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <!-- 1-й столбец -->
                <ColumnDefinition/>
                <!-- 2-й столбец -->
                <ColumnDefinition/>
                <!-- 3-й столбец -->
                <ColumnDefinition/>
                <!-- 4-й столбец -->
            </Grid.ColumnDefinitions>

            <!-- 1-я Строка: Кнопки управления и деления -->
            <!-- Кнопка очистки (С), объединяет первый и второй столбец (Grid.ColumnSpan="2") -->
            <Button Content="C" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="3" Click="Clear_Click" Background="#E6E6E6" FontSize="18" FontWeight="Bold"/>
            <!-- Кнопка Backspace для стирания последней введенной цифры -->
            <Button Content="⌫" Grid.Row="0" Grid.Column="2" Margin="3" Click="Backspace_Click" Background="#E6E6E6" FontSize="18"/>
            <!-- Кнопка Деления, передает знак "/" через свойство Tag в C#-код -->
            <Button Content="/" Grid.Row="0" Grid.Column="3" Tag="/" Margin="3" Click="Operator_Click" Background="#FAE19C" FontSize="20" FontWeight="Bold"/>

            <!-- 2-я Строка: Цифровые кнопки 7, 8, 9 и операция умножения -->
            <Button Content="7" Grid.Row="1" Grid.Column="0" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <Button Content="8" Grid.Row="1" Grid.Column="1" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <Button Content="9" Grid.Row="1" Grid.Column="2" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <!-- Кнопка Умножения, передает знак "*" через свойство Tag -->
            <Button Content="*" Grid.Row="1" Grid.Column="3" Tag="*" Margin="3" Click="Operator_Click" Background="#FAE19C" FontSize="20" FontWeight="Bold"/>

            <!-- 3-я Строка: Цифровые кнопки 4, 5, 6 и операция вычитания -->
            <Button Content="4" Grid.Row="2" Grid.Column="0" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <Button Content="5" Grid.Row="2" Grid.Column="1" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <Button Content="6" Grid.Row="2" Grid.Column="2" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <!-- Кнопка Вычитания, передает знак "-" через свойство Tag -->
            <Button Content="-" Grid.Row="2" Grid.Column="3" Tag="-" Margin="3" Click="Operator_Click" Background="#FAE19C" FontSize="20" FontWeight="Bold"/>

            <!-- 4-я Строка: Цифровые кнопки 1, 2, 3 и операция сложения -->
            <Button Content="1" Grid.Row="3" Grid.Column="0" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <Button Content="2" Grid.Row="3" Grid.Column="1" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <Button Content="3" Grid.Row="3" Grid.Column="2" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <!-- Кнопка Сложения, передает знак "+" через свойство Tag -->
            <Button Content="+" Grid.Row="3" Grid.Column="3" Tag="+" Margin="3" Click="Operator_Click" Background="#FAE19C" FontSize="20" FontWeight="Bold"/>

            <!-- 5-я Строка: Смена знака, Ноль, Десятичный разделитель и Вычисление -->
            <!-- Кнопка изменения знака числа (+/-) -->
            <Button Content="+/-" Grid.Row="4" Grid.Column="0" Margin="3" Click="Sign_Click" FontSize="18" Background="White"/>
            <!-- Кнопка ввода цифры ноль -->
            <Button Content="0" Grid.Row="4" Grid.Column="1" Margin="3" Click="Digit_Click" FontSize="18" Background="White"/>
            <!-- Кнопка ввода десятичного разделителя (запятой или точки) -->
            <Button Content="," Grid.Row="4" Grid.Column="2" Margin="3" Click="Decimal_Click" FontSize="18" Background="White"/>
            <!-- Кнопка «Равно» для подсчета итогового арифметического результата -->
            <Button Content="=" Grid.Row="4" Grid.Column="3" Margin="3" Click="Equals_Click" Background="#96E296" FontSize="20" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
