<Window x:Class="Задание_5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор"
        Height="550" Width="380"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10" Background="#F0F2F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="Display"
                 Grid.Row="0"
                 Text="0"
                 FontSize="32"
                 IsReadOnly="True"
                 TextAlignment="Right"
                 Padding="10"
                 Margin="0,0,0,10"/>

        <UniformGrid Grid.Row="1" Columns="4" Rows="5">
            <Button Content="C" Click="Clear_Click"/>
            <Button Content="⌫" Click="Backspace_Click"/>
            <Button Content="±" Click="Sign_Click"/>
            <Button Content="÷" Tag="/" Click="Operator_Click"/>

            <Button Content="7" Click="Digit_Click"/>
            <Button Content="8" Click="Digit_Click"/>
            <Button Content="9" Click="Digit_Click"/>
            <Button Content="×" Tag="*" Click="Operator_Click"/>

            <Button Content="4" Click="Digit_Click"/>
            <Button Content="5" Click="Digit_Click"/>
            <Button Content="6" Click="Digit_Click"/>
            <Button Content="−" Tag="-" Click="Operator_Click"/>

            <Button Content="1" Click="Digit_Click"/>
            <Button Content="2" Click="Digit_Click"/>
            <Button Content="3" Click="Digit_Click"/>
            <Button Content="+" Tag="+" Click="Operator_Click"/>

            <Button Content="0" Click="Digit_Click"/>
            <Button Content="," Click="Decimal_Click"/>
            <Button Content="=" Click="Equals_Click"/>
            <Button Content="Очистить" Click="Clear_Click"/>
        </UniformGrid>
    </Grid>
</Window>
