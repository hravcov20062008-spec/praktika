<Window x:Class="Задание_4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображений"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel Background="#F0F2F5">

        <!-- Верхняя панель -->
        <Border DockPanel.Dock="Top"
                Background="#263859"
                Padding="10">

            <StackPanel Orientation="Horizontal">
                <Button Content="Открыть изображение"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        Click="OpenImage_Click"/>

                <Button Content="− Уменьшить"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        Click="ZoomOut_Click"/>

                <Button Content="+ Увеличить"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        Click="ZoomIn_Click"/>

                <Button Content="100%"
                        Padding="12,7"
                        Margin="0,0,10,0"
                        Click="ResetZoom_Click"/>

                <Button Content="По размеру окна"
                        Padding="12,7"
                        Click="FitImage_Click"/>
            </StackPanel>
        </Border>

        <!-- Область просмотра -->
        <Border Margin="10"
                Background="#202020"
                BorderBrush="#B0B0B0"
                BorderThickness="1"
                ClipToBounds="True">

            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center">

                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       RenderTransformOrigin="0,0">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ImageScale"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Image.LayoutTransform>
                </Image>

            </ScrollViewer>
        </Border>

        <!-- Строка состояния -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText"
                       Text="Выберите изображение для просмотра"/>

            <Separator/>

            <TextBlock x:Name="ZoomText"
                       Text="Масштаб: 100%"/>
        </StatusBar>

    </DockPanel>
</Window>
