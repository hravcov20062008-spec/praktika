<Window x:Class="Задание_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор"
        Height="600" Width="900"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Background="LightSteelBlue"
                    Margin="8"
                    VerticalAlignment="Center">

            <TextBlock Text="Фигура:"
                       VerticalAlignment="Center"
                       Margin="8"/>

            <ComboBox x:Name="ShapeSelector"
                      Width="120"
                      SelectedIndex="0"
                      Margin="5">
                <ComboBoxItem Content="Линия"/>
                <ComboBoxItem Content="Круг"/>
                <ComboBoxItem Content="Квадрат"/>
            </ComboBox>

            <TextBlock Text="Цвет:"
                       VerticalAlignment="Center"
                       Margin="8"/>

            <ComboBox x:Name="ColorSelector"
                      Width="100"
                      SelectedIndex="0"
                      Margin="5">
                <ComboBoxItem Content="Чёрный"/>
                <ComboBoxItem Content="Красный"/>
                <ComboBoxItem Content="Синий"/>
                <ComboBoxItem Content="Зелёный"/>
            </ComboBox>

            <Button Content="Очистить холст"
                    Width="120"
                    Margin="10,5"
                    Click="ClearCanvas_Click"/>
        </StackPanel>

        <!-- Область рисования -->
        <Border Grid.Row="1"
                Margin="8,0,8,8"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="White">

            <Canvas x:Name="DrawingCanvas"
                    Background="White"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                    MouseMove="Canvas_MouseMove"/>
        </Border>

        <!-- Подсказка -->
        <TextBlock Grid.Row="2"
                   Text="Выберите фигуру и цвет. Зажмите левую кнопку мыши и перемещайте курсор по холсту."
                   Margin="10"
                   Foreground="DimGray"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
