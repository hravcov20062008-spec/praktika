<Window x:Class="Задание_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Задание_2"
        mc:Ignorable="d"
        Title="Управление проектами и задачами"
        Height="700" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#24364B" Padding="15">
            <TextBlock Text="УПРАВЛЕНИЕ ПРОЕКТАМИ И ЗАДАЧАМИ"
                       Foreground="White"
                       FontSize="21"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <TabControl Grid.Row="1" Margin="10">

            <!-- ПРОЕКТЫ -->
            <TabItem Header="Проекты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Название проекта"/>
                        <TextBox x:Name="txtProjectName"
                                 Margin="0,4,0,8" Padding="6"/>

                        <TextBlock Text="Описание"/>
                        <TextBox x:Name="txtProjectDescription"
                                 Margin="0,4,0,8" Padding="6"
                                 Height="55"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>
                    </StackPanel>

                    <DataGrid x:Name="dgProjects"
                              Grid.Row="1"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionChanged="dgProjects_SelectionChanged"
                              Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="2">
                        <Button Content="Добавить"
                                Click="AddProject_Click"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Изменить"
                                Click="EditProject_Click"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Удалить"
                                Click="DeleteProject_Click"
                                Padding="12,6"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- СОТРУДНИКИ -->
            <TabItem Header="Сотрудники">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="ФИО сотрудника"/>
                        <TextBox x:Name="txtEmployeeName"
                                 Margin="0,4,0,8" Padding="6"/>

                        <TextBlock Text="Должность"/>
                        <TextBox x:Name="txtEmployeePosition"
                                 Margin="0,4,0,8" Padding="6"/>
                    </StackPanel>

                    <DataGrid x:Name="dgEmployees"
                              Grid.Row="1"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionChanged="dgEmployees_SelectionChanged"
                              Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="2">
                        <Button Content="Добавить"
                                Click="AddEmployee_Click"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Изменить"
                                Click="EditEmployee_Click"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Удалить"
                                Click="DeleteEmployee_Click"
                                Padding="12,6"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ЗАДАЧИ -->
            <TabItem Header="Задачи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Название задачи"/>
                        <TextBox x:Name="txtTaskTitle"
                                 Margin="0,4,0,6" Padding="6"/>

                        <TextBlock Text="Проект"/>
                        <ComboBox x:Name="cmbTaskProject"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Margin="0,4,0,6" Padding="5"/>

                        <TextBlock Text="Ответственный сотрудник"/>
                        <ComboBox x:Name="cmbTaskEmployee"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="Id"
                                  Margin="0,4,0,6" Padding="5"/>

                        <TextBlock Text="Статус"/>
                        <ComboBox x:Name="cmbTaskStatus"
                                  Margin="0,4,0,6" Padding="5">
                            <ComboBoxItem Content="Новая"/>
                            <ComboBoxItem Content="В работе"/>
                            <ComboBoxItem Content="Завершена"/>
                            <ComboBoxItem Content="Приостановлена"/>
                        </ComboBox>

                        <TextBlock Text="Прогресс (0–100%)"/>
                        <TextBox x:Name="txtTaskProgress"
                                 Text="0"
                                 Margin="0,4,0,6" Padding="6"/>
                    </StackPanel>

                    <DataGrid x:Name="dgTasks"
                              Grid.Row="1"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionChanged="dgTasks_SelectionChanged"
                              Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="2">
                        <Button Content="Добавить"
                                Click="AddTask_Click"
                                Padding="10,6" Margin="0,0,5,0"/>
                        <Button Content="Изменить"
                                Click="EditTask_Click"
                                Padding="10,6" Margin="0,0,5,0"/>
                        <Button Content="Удалить"
                                Click="DeleteTask_Click"
                                Padding="10,6" Margin="0,0,5,0"/>
                        <Button Content="Обновить"
                                Click="Refresh_Click"
                                Padding="10,6"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ОТЧЁТЫ -->
            <TabItem Header="Отчёты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ОТЧЁТ ПО ПРОЕКТАМ И ЗАДАЧАМ"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="dgReport"
                              Grid.Row="1"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Margin="0,0,0,10"/>

                    <WrapPanel Grid.Row="2">
                        <Button Content="Сформировать отчёт"
                                Click="GenerateReport_Click"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Сохранить в TXT"
                                Click="ExportReport_Click"
                                Padding="12,6"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
