<Window x:Class="Задание_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление задачами"
        Height="650" Width="1000"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="УПРАВЛЕНИЕ ЗАДАЧАМИ"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                BorderBrush="LightGray"
                BorderThickness="1"
                Padding="10"
                CornerRadius="5"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Название задачи"/>
                    <TextBox x:Name="txtTitle" Height="28"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Приоритет"/>
                    <ComboBox x:Name="cmbPriority"
                              Height="28"
                              SelectedIndex="1">
                        <ComboBoxItem Content="Низкий"/>
                        <ComboBoxItem Content="Средний"/>
                        <ComboBoxItem Content="Высокий"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="Срок выполнения"/>
                    <DatePicker x:Name="dpDeadline"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="5">
                    <TextBlock Text="Описание"/>
                    <TextBox x:Name="txtDescription"
                             Height="45"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                    <TextBlock Text="Прогресс (%)"/>
                    <TextBox x:Name="txtProgress"
                             Height="28"
                             Text="0"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="5">
                    <TextBlock Text="Статус"/>
                    <ComboBox x:Name="cmbStatus"
                              Height="28"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="В работе"/>
                        <ComboBoxItem Content="Завершена"/>
                    </ComboBox>
                </StackPanel>

                <WrapPanel Grid.Row="3"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           HorizontalAlignment="Center"
                           Margin="5,10,5,0">
                    <Button Content="Добавить"
                            Width="110" Margin="4" Padding="5"
                            Click="Add_Click"/>
                    <Button Content="Изменить"
                            Width="110" Margin="4" Padding="5"
                            Click="Edit_Click"/>
                    <Button Content="Удалить"
                            Width="110" Margin="4" Padding="5"
                            Click="Delete_Click"/>
                    <Button Content="Очистить"
                            Width="110" Margin="4" Padding="5"
                            Click="Clear_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgTasks"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="dgTasks_SelectionChanged"
                  CanUserAddRows="False"/>

        <TextBlock x:Name="lblNotifications"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   FontSize="14"
                   FontWeight="Bold"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
