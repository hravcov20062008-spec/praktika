<Window x:Class="Задание_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система учёта задач"
        Height="600" Width="950"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="УЧЁТ ЗАДАЧ"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#245A81"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Название задачи"/>
                    <TextBox x:Name="txtTitle"
                             Height="32"
                             Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Срок выполнения"/>
                    <DatePicker x:Name="dpDueDate"
                                Height="32"
                                Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="Статус"/>
                    <ComboBox x:Name="cmbStatus"
                              Height="32"
                              Margin="0,5,0,0"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="В работе"/>
                        <ComboBoxItem Content="Выполнена"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="5">
                    <TextBlock Text="Описание задачи"/>
                    <TextBox x:Name="txtDescription"
                             Height="60"
                             Margin="0,5,0,0"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <WrapPanel Grid.Row="2"
                           Grid.ColumnSpan="3"
                           Margin="5,12,5,0">
                    <Button Content="Добавить"
                            Width="110" Height="35"
                            Margin="0,0,8,5"
                            Click="btnAdd_Click"/>

                    <Button Content="Изменить"
                            Width="110" Height="35"
                            Margin="0,0,8,5"
                            Click="btnEdit_Click"/>

                    <Button Content="Удалить"
                            Width="110" Height="35"
                            Margin="0,0,8,5"
                            Click="btnDelete_Click"/>

                    <Button Content="Очистить поля"
                            Width="125" Height="35"
                            Margin="0,0,8,5"
                            Click="btnClear_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="dgvTasks"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="dgvTasks_SelectionChanged"
                  Margin="0,0,0,10"/>

        <TextBlock x:Name="lblStatus"
                   Grid.Row="3"
                   Text="Количество задач: 0"
                   Foreground="Gray"
                   FontSize="13"/>
    </Grid>
</Window>
